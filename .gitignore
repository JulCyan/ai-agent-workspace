# Ignore everything in root by default
/*

# Whitelist specific config files/folders in root
!/.vscode/
!/.workspace/
!/*.code-workspace
!/.gitignore
!/*.md
!/LICENSE

# .vscode: Track everything
!/.vscode/**

# ==============================
# .agent: Granular Control
# ==============================
!/.agent/
/.agent/*

# Always track: rules, workflows, docs
!/.agent/rules/
!/.agent/rules/**
!/.agent/workflows/
!/.agent/workflows/**
!/.agent/docs/
!/.agent/docs/**
/.agent/docs/archive/

# ==============================
# projects: Privacy First
# ==============================
!/.agent/projects/
/.agent/projects/**
!/.agent/projects/shared/
!/.agent/projects/shared/**

!.agent/context/
!.agent/context/**

!.agent/skills/
!.agent/skills/**
