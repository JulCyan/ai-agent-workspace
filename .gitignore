# Ignore everything in root by default
/*

# Whitelist specific config files/folders in root
!/.vscode/
!/.workspace/
!/*.code-workspace
!/.gitignore
!/*.md
!/LICENSE

# .vscode: Track everything
!/.vscode/**

# ==============================
# .agent: Granular Control
# ==============================
!/.agent/
/.agent/*

# Always track: rules, workflows, docs (templates)
!/.agent/rules/
!/.agent/rules/**
!/.agent/workflows/
!/.agent/workflows/**
!/.agent/docs/
!/.agent/docs/**
/.agent/docs/archive/

# Track projects (active projects)
!/.agent/projects/
!/.agent/projects/**

# ⚠️ Do NOT track: archive (completed projects inside projects)
/.agent/projects/archive/

# Template files
!/.agent/pending-backend-template.md
