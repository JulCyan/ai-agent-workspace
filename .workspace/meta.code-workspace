{
	"folders": [
		{
			"path": "../.",
		}
	],
	"settings": {
		// 🏷️ Admin Mode Tags
		"agent.active_rule_tags": [
			"core",
			"general",
			"workflow"
		],
		// 🛑 Stop scanning specific sub-projects for Source Control
		"git.autoRepositoryDetection": "openEditors",
		"files.autoSave": "onFocusChange",
		"editor.formatOnSave": true,
		"files.trimTrailingWhitespace": true,
		"files.insertFinalNewline": true,
		"search.exclude": {
			"**/node_modules": true,
			"**/bower_components": true,
			"**/*.code-search": true,
			"**/.egg": true,
			"**/run": true,
			"**/dist": true,
			"**/coverage": true,
			"**/.history": true,
			"**/.idea": true
		},
		"files.watcherExclude": {
			"**/node_modules/**": true,
			"**/dist/**": true,
			"**/.git/objects/**": true,
			"**/.egg/**": true,
			"**/coverage/**": true
		},
		"files.exclude": {
			// Hide all sub-projects in this Admin view
			// Only show config files and folders relevant to the meta-repo
			"fe-*": true,
			"go-*": true,
			"node_modules": true,
			// Hide these from root view as they are explicit folders above
			".git": true
		}
	}
}
